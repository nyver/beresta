[Unit]
Description=Beresta home synchronization server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beresta
Group=beresta
StateDirectory=beresta
StateDirectoryMode=0700
ExecStart=/opt/beresta/beresta-server --data /var/lib/beresta
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/beresta
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
