{
  "$comment": "Beresta semantic design token manifest (task 10.1). Single source of truth for spacing, typography, radius, elevation, border, focus, icon size, animation duration, and semantic color roles shared by the Windows (React/CSS) and Android (Flutter) clients. See design/tokens.md for rationale and per-token usage notes. Do not add component- or feature-specific keys here; only semantic roles that both clients can consume.",
  "version": 1,
  "spacing": {
    "0": "0rem",
    "1": "0.15rem",
    "2": "0.2rem",
    "3": "0.25rem",
    "4": "0.35rem",
    "5": "0.5rem",
    "6": "0.6rem",
    "7": "0.75rem",
    "8": "1rem",
    "9": "1.25rem",
    "10": "1.5rem",
    "11": "2rem",
    "12": "3rem"
  },
  "typography": {
    "fontFamily": {
      "base": "Inter, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.85rem",
      "base": "1rem",
      "md": "1.1rem",
      "lg": "1.25rem",
      "xl": "1.5rem"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "base": 1.5
    }
  },
  "radius": {
    "none": "0rem",
    "xs": "0.15rem",
    "sm": "0.35rem",
    "md": "0.5rem",
    "pill": "1rem",
    "full": "9999px"
  },
  "elevation": {
    "0": "none",
    "1": "0 0.25rem 0.75rem rgba(30, 27, 24, 0.2)",
    "2": "0 0.25rem 1rem rgba(30, 27, 24, 0.35)",
    "3": "0 0.5rem 2rem rgba(30, 27, 24, 0.3)"
  },
  "border": {
    "width": {
      "hairline": "1px",
      "thick": "2px"
    },
    "style": {
      "solid": "solid",
      "dashed": "dashed"
    }
  },
  "focus": {
    "ringColor": "{color.accent.default}",
    "ringWidth": "2px",
    "ringOffset": "2px",
    "ringStyle": "solid"
  },
  "iconSize": {
    "sm": "1rem",
    "md": "1.25rem",
    "lg": "1.5rem",
    "xl": "2rem"
  },
  "touchTarget": {
    "minimum": "2.75rem",
    "$comment": "WCAG 2.5.8 AA minimum (44px/2.75rem). Several existing controls (tree-toggle at 1.25rem, kebab/add buttons at 1.5rem) fall short today; remediating them is tracked as part of task 10.5, not this manifest."
  },
  "animationDuration": {
    "instant": "0ms",
    "fast": "120ms",
    "base": "200ms",
    "slow": "800ms"
  },
  "motion": {
    "reducedMotionOverride": "{animationDuration.instant}",
    "$comment": "When the platform requests reduced motion, every animationDuration token resolves to `instant` instead. See task 10.4."
  },
  "color": {
    "background": {
      "canvas": "#f8f6f1",
      "surface": "#ffffff",
      "surfaceSunken": "#faf8f4",
      "panel": "#f1eee6",
      "selectedTint": "#f5efe3"
    },
    "text": {
      "primary": "#1e1b18",
      "heading": "#3a332a",
      "secondary": "#5a5148",
      "muted": "#6e6659",
      "neutralMuted": "#7d7469",
      "disabled": "#b3a996",
      "onAccent": "#ffffff"
    },
    "border": {
      "default": "#d8d1c4",
      "subtle": "#eee2d0"
    },
    "accent": {
      "default": "#6b4f2a",
      "hoverTint": "#eee2d0",
      "hoverStrong": "#f1e6d3",
      "highlight": "#e8c887"
    },
    "status": {
      "info": "#2f6f9f",
      "success": "#3a6b2a",
      "successTint": "#e3f0d8",
      "warning": "#8a5a1f",
      "warningStrong": "#b36a20",
      "warningTint": "#fbe8c6",
      "danger": "#8a2c1f",
      "dangerStrong": "#b23b3b",
      "dangerTint": "#f7dede",
      "neutral": "#7d7469"
    },
    "highlight": {
      "searchMatch": "#f4d78a"
    },
    "overlay": {
      "scrim": "rgba(30, 27, 24, 0.5)"
    },
    "inverse": {
      "background": "#2b2118",
      "text": "#f8f6f1"
    }
  }
}
