{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beresta.app/schema/update-manifest-v1.schema.json",
  "title": "Beresta Windows update manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "version",
    "platform",
    "artifact",
    "size_bytes",
    "sha256",
    "signature"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "platform": {
      "const": "windows-amd64"
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.exe$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  }
}
